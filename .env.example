# --- Sanity content (app + seed) ---
# Project ID from sanity.io/manage
SANITY_PROJECT_ID=
# Dataset name (private)
SANITY_DATASET=production
# Viewer token: server-side GROQ reads for the app
SANITY_READ_TOKEN=
# Editor token: only needed for `pnpm sanity:seed`
SANITY_WRITE_TOKEN=

# --- Sanity Context MCP (DM agent) ---
# GROQ-mode MCP endpoint URL (dataset source)
SANITY_CONTEXT_MCP_URL=
# Token for the GROQ-mode endpoint (org token with Context Viewer for org-style URLs)
SANITY_CONTEXT_TOKEN=
# Knowledge Base-mode MCP endpoint URL (rules + conditions KB)
SANITY_KB_MCP_URL=
# Org token with the Context Viewer role for the KB endpoint
SANITY_KB_TOKEN=

# --- AI ---
# Baseten API key (https://app.baseten.co/settings/api_keys)
BASETEN_API_KEY=
# Optional model override (default deepseek-ai/DeepSeek-V4.1-Flash, a Baseten Model API slug)
DM_MODEL=

# --- Studio (studio/.env or shell) ---
# Same as SANITY_PROJECT_ID; read by studio/sanity.config.ts
SANITY_STUDIO_PROJECT_ID=
# Same as SANITY_DATASET
SANITY_STUDIO_DATASET=production
